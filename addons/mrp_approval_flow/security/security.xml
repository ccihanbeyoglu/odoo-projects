<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_mo_approval" model="res.groups.privilege">
        <field name="name">MO Approval</field>
        <field name="sequence">6</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_mo_requester" model="res.groups">
        <field name="name">Requester</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_mo_approval"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>

    <!-- The administrator is an approver after installation, like the
         administrator group of the Manufacturing app itself. -->
    <record id="group_mo_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_mo_approval"/>
        <field name="implied_ids" eval="[(4, ref('group_mo_requester'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
