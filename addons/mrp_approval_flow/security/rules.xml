<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The log follows the visibility of its manufacturing order's company. -->
    <record id="mrp_approval_log_company_rule" model="ir.rule">
        <field name="name">MO approval log: multi-company</field>
        <field name="model_id" ref="model_mrp_approval_log"/>
        <field name="domain_force">[('production_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
